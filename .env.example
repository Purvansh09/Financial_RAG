# Copy this file to .env and fill in real values. Never commit .env.

# Required from Phase 3 (answer generation) onward.
ANTHROPIC_API_KEY=
# Optional: override the Claude model or effort set in config.py.
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium

# Optional: only if API calls fail with CERTIFICATE_VERIFY_FAILED because antivirus software
# (e.g. Avast) inspects HTTPS traffic. Point it at that software's root certificate.
# SSL_CERT_FILE=C:\ProgramData\Avast Software\Avast\wscert.pem
